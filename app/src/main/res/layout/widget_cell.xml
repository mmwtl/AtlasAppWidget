<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cell"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/widget_cell_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:scaleType="centerInside" />

    <!-- Themed labels: white masks under the icon, tinted by the host with the theme colors. -->
    <ImageView
        android:id="@+id/widget_cell_outline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:contentDescription="@null"
        android:scaleType="center"
        android:tint="@color/widget_label_outline"
        android:tintMode="multiply" />

    <ImageView
        android:id="@+id/widget_cell_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:contentDescription="@null"
        android:scaleType="center"
        android:tint="@color/widget_text" />
</FrameLayout>
