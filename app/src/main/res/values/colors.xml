<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="atlas_background">#171717</color>
    <color name="atlas_accent">#7893A0</color>
    <color name="icon_background">#171717</color>

    <!-- Home screen widget, launcher day palette; night values live in values-night. The widget
         host resolves them, so the widget switches with the OneOS night mode on its own. -->
    <color name="widget_surface">#EDEEF0</color>
    <color name="widget_text">#202124</color>
    <!-- Only light text has an outline; on a light panel a white one just blurs dark text. -->
    <color name="widget_label_outline">#00000000</color>
    <!-- Labels and status text for a panel that is dark by day and light at night. -->
    <color name="widget_text_inverse">#F1F2F4</color>
    <color name="widget_label_outline_inverse">#000000</color>
    <!-- Darkens the CPU, RAM and fuel fills by 30% by day to keep them 3:1 to the panel. -->
    <color name="widget_status_fill_shade">#4D000000</color>
    <!-- Gates for the panels in the separate day and night colors. -->
    <color name="widget_day_only">#FFFFFFFF</color>
    <color name="widget_night_only">#00000000</color>
</resources>
