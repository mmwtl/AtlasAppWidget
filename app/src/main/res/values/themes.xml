<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AtlasWidget" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/atlas_accent</item>
        <item name="android:windowBackground">@color/atlas_background</item>
        <item name="android:navigationBarColor">@color/atlas_background</item>
        <item name="android:statusBarColor">@color/atlas_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.AtlasWidget.Diagnostic" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowAnimationStyle">@style/AnimationAtlasNoAnimation</item>
    </style>

    <style name="Theme.AtlasWidget.WidgetLaunch" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@style/AnimationAtlasNoAnimation</item>
    </style>

    <style name="Theme.AtlasWidget.FuelDialog" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/atlas_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@style/AnimationAtlasNoAnimation</item>
    </style>

    <style name="Theme.AtlasWidget.Setup" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/atlas_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>

    <style name="AnimationAtlasNoAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/atlas_no_animation</item>
        <item name="android:activityOpenExitAnimation">@anim/atlas_no_animation</item>
        <item name="android:activityCloseEnterAnimation">@anim/atlas_no_animation</item>
        <item name="android:activityCloseExitAnimation">@anim/atlas_no_animation</item>
    </style>
</resources>
